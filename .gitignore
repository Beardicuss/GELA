*.py[cod]
*.pyo
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/
.coverage
coverage.xml
htmlcov/

# Build and release products
build/
dist/
release/
*.spec.bak
*.exe
*.msi
*.zip

# Large third-party speech models (downloaded separately)
models/*
