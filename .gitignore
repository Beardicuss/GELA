# Runtime and machine-local state
logs/
runtime/
*.log
config/apps.json
config/alias_archive.json
config/vocabulary_audit.json
config/learned_process_targets.json

# Local settings and secrets
.env
.env.*
!.env.example
*.pfx
*.p12
*.pem
*.key
*.cer
*.crt

# Editors and operating systems
.idea/
.vscode/
*.code-workspace
.DS_Store
Thumbs.db
Desktop.ini

